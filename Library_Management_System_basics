-- Display all books
SELECT * FROM Books;

-- Display all students
SELECT * FROM Students;

-- Display only book names
SELECT BookName FROM Books;

-- Display student names and cities
SELECT StudentName, City FROM Students;

-- Find books costing more than 500
SELECT * FROM Books
WHERE Price > 500;

-- Find students from Mumbai
SELECT * FROM Students
WHERE City = 'Mumbai';

-- Find students older than 20
SELECT * FROM Students
WHERE Age > 20;

-- Find Programming books
SELECT * FROM Books
WHERE Category = 'Programming';


-- AND
SELECT * FROM Books
WHERE Price > 400 AND AvailableCopies > 3;

-- OR
SELECT * FROM Students
WHERE City = 'Mumbai' OR City = 'Pune';

-- NOT
SELECT * FROM Students
WHERE NOT City = 'Mumbai';


UPDATE Books
SET Price = 480
WHERE BookID = 1;

UPDATE Students
SET City = 'Thane'
WHERE StudentID = 105;

