CREATE TABLE Books (
    BookID INT,
    BookName VARCHAR(50),
    Author VARCHAR(50),
    Category VARCHAR(30),
    Price INT,
    AvailableCopies INT
);



CREATE TABLE Students (
    StudentID INT,
    StudentName VARCHAR(50),
    Age INT,
    City VARCHAR(30),
    Course VARCHAR(30)
);



CREATE TABLE IssuedBooks (
    IssueID INT,
    StudentID INT,
    BookID INT,
    IssueDate DATE,
    ReturnDate DATE
);



